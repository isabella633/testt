					knob[k] = v
				end
			else
				tween(pill, pillProps)
				tween(knob, knobProps)
			end
		end

		function control:Set(v, silent)
			state = v == true
			render(false)
			if not silent then
				safeCall(name, cfg.Callback, state)
			end
		end

		function control:Get()
			return state
		end

		hit.Activated:Connect(function()
			control:Set(not state)
		end)

		state = cfg.Default == true
		render(true)
		register(self, cfg, control)
		if state then
			safeCall(name, cfg.Callback, true)
		end
		return control
	end

	function TabMethods:Slider(cfg)
		if type(cfg) ~= "table" then
			cfg = { Name = tostring(cfg) }
		end
		local name = tostring(cfg.Name or "Slider")
		local min = tonumber(cfg.Min) or 0
