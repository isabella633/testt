		valueLbl.Position = UDim2.new(1, -30, 0, 0)
		valueLbl.Size = UDim2.new(0.5, -34, 1, 0)
		valueLbl.TextTruncate = Enum.TextTruncate.AtEnd

		local arrow = text(header, "+", 14, C.Dim, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
		arrow.AnchorPoint = Vector2.new(1, 0)
		arrow.Position = UDim2.new(1, -8, 0, 0)
		arrow.Size = UDim2.fromOffset(18, 34)

		local optFrame = new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Visible = false,
			LayoutOrder = 2,
		}, row)
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }, optFrame)
		new("UIPadding", {
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
			PaddingBottom = UDim.new(0, 8),
		}, optFrame)

		local optButtons = {}
		local selected = nil -- single mode
		local chosen = {} -- multi mode: option index -> true
		local expanded = false

		local function displayText()
			if multi then
				local names = {}
				for i, opt in ipairs(options) do
					if chosen[i] then
						names[#names + 1] = tostring(opt)
					end
				end
				if #names == 0 then
					return "None"
				end
				return table.concat(names, ", ")
			end
			if selected == nil then
				return "Select"
			end
			return tostring(selected)
		end

		local function refresh()
			valueLbl.Text = displayText()
			for i, b in ipairs(optButtons) do
				local on
				if multi then
					on = chosen[i] == true
				else
					on = selected ~= nil and tostring(options[i]) == tostring(selected)
				end
				b.BackgroundColor3 = on and C.Accent or C.Panel
				b.TextColor3 = on and C.AccentText or C.Text
			end
		end

		local function current()
			if multi then
				local out = {}
				for i, opt in ipairs(options) do
					if chosen[i] then
						out[#out + 1] = opt
						out[tostring(opt)] = true
					end
				end
				return out
			end
			return selected
		end

		local function fire()
			safeCall(name, cfg.Callback, current())
		end

		local function setExpanded(v)
			expanded = v
			optFrame.Visible = v
			arrow.Text = v and "-" or "+"
		end

		for i, opt in ipairs(options) do
			local b = new("TextButton", {
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Size = UDim2.new(1, 0, 0, 26),
				Text = tostring(opt),
				TextSize = 12,
				Font = Enum.Font.GothamMedium,
				TextColor3 = C.Text,
				LayoutOrder = i,
			}, optFrame)
			round(b, 5)
			optButtons[i] = b
			b.Activated:Connect(function()
				if multi then
					chosen[i] = not chosen[i] or nil
				else
					selected = opt
					setExpanded(false)
				end
				refresh()
				fire()
			end)
		end

		header.Activated:Connect(function()
			setExpanded(not expanded)
		end)

		local control = { Name = name, Flag = cfg.Flag }

		function control:Set(v, silent)
			if multi then
				chosen = {}
				if type(v) == "table" then
					local wanted = {}
					for k, val in pairs(v) do
						if val == true then
							wanted[tostring(k)] = true
						elseif type(val) ~= "boolean" then
							wanted[tostring(val)] = true
						end
					end
					for i, opt in ipairs(options) do
						if wanted[tostring(opt)] then
							chosen[i] = true
						end
					end
				end
			else
				selected = v
				for _, opt in ipairs(options) do
					if tostring(opt) == tostring(v) then
						selected = opt
					end
				end
			end
			refresh()
			if not silent then
				fire()
			end
		end

		function control:Get()
			return current()
		end

		register(self, cfg, control)

		if multi then
			control:Set(cfg.Default, true)
			if next(chosen) ~= nil then
				fire()
			end
		else
			refresh()
			if cfg.Default ~= nil then
				control:Set(cfg.Default, true)
				fire()
			end
		end
		return control
	end

