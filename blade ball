			DisplayOrder = 100,
			IgnoreGuiInset = true,
		})

		-- pick a parent: what the script asked for, then gethui, CoreGui, PlayerGui
		local candidates = {}
		local function addCandidate(getter)
			local ok, v = pcall(getter)
			if ok and v then
				candidates[#candidates + 1] = v
			end
		end
		addCandidate(function() return cfg.Parent end)
		addCandidate(function() return gethui() end)
		addCandidate(function() return game:GetService("CoreGui") end)
		addCandidate(function() return Players.LocalPlayer:WaitForChild("PlayerGui") end)
		for _, p in ipairs(candidates) do
			pcall(function()
				local old = p:FindFirstChild("KittylolMenu")
				if old then
					old:Destroy()
				end
			end)
		end
		local parented = false
		for _, p in ipairs(candidates) do
			if not parented then
				local ok = pcall(function() gui.Parent = p end)
				if ok and gui.Parent == p then
