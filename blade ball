			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
		}, row)
		hoverable(row, hit)

		local state = false
		local control = { Name = name, Flag = cfg.Flag }

		local function render(instant)
			local pillProps = { BackgroundColor3 = state and C.Accent or C.Off }
			local knobProps = {
				Position = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
				BackgroundColor3 = state and C.AccentText or C.Dim,
			}
