		end)

		local values = {
			math.floor(start.R * 255 + 0.5),
			math.floor(start.G * 255 + 0.5),
			math.floor(start.B * 255 + 0.5),
		}
		local setters = {}

		local function currentColor()
			return Color3.fromRGB(values[1], values[2], values[3])
		end

		local function push(silent)
			swatch.BackgroundColor3 = currentColor()
			if not silent then
				safeCall(name, cfg.Callback, currentColor())
			end
		end

		local channels = { "R", "G", "B" }
		for idx, channel in ipairs(channels) do
			local line = new("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				LayoutOrder = idx,
			}, panel)
			local cl = text(line, channel, 11, C.Dim, Enum.Font.GothamBold)
			cl.Size = UDim2.fromOffset(14, 20)
			local vl = text(line, tostring(values[idx]), 11, C.Dim, Enum.Font.GothamMedium, Enum.TextXAlignment.Right)
			vl.AnchorPoint = Vector2.new(1, 0)
			vl.Position = UDim2.new(1, 0, 0, 0)
			vl.Size = UDim2.fromOffset(32, 20)

			local hit = new("TextButton", {
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
				Position = UDim2.fromOffset(20, 0),
				Size = UDim2.new(1, -58, 1, 0),
			}, line)
			local bar = new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.new(1, 0, 0, 6),
				BackgroundColor3 = C.Off,
				BorderSizePixel = 0,
			}, hit)
			round(bar, 3)
			local fill = new("Frame", {
				Size = UDim2.fromScale(0, 1),
				BackgroundColor3 = C.Accent,
				BorderSizePixel = 0,
			}, bar)
			round(fill, 3)
			local knob = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.fromOffset(12, 12),
				BackgroundColor3 = C.Accent,
				BorderSizePixel = 0,
			}, bar)
			round(knob, 6)

			local function setChannel(v, silent)
				v = math.clamp(math.floor(v + 0.5), 0, 255)
				local changed = v ~= values[idx]
				values[idx] = v
				local a = v / 255
				fill.Size = UDim2.fromScale(a, 1)
				knob.Position = UDim2.new(a, 0, 0.5, 0)
				vl.Text = tostring(v)
				if silent then
					push(true)
				elseif changed then
					push(false)
				end
			end
			setters[idx] = setChannel

			bindDrag(hit, function(input)
				local w = bar.AbsoluteSize.X
				if w <= 0 then
					return
				end
				local a = math.clamp((input.Position.X - bar.AbsolutePosition.X) / w, 0, 1)
				setChannel(255 * a, false)
			end)

			setChannel(values[idx], true)
		end

		local control = { Name = name, Flag = cfg.Flag }
		function control:Set(c, silent)
			if typeof(c) ~= "Color3" then
				return
			end
			setters[1](c.R * 255, true)
			setters[2](c.G * 255, true)
			setters[3](c.B * 255, true)
			push(silent)
		end
		function control:Get()
			return currentColor()
		end

		register(self, cfg, control)
		safeCall(name, cfg.Callback, currentColor())
		return control
	end

