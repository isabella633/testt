		function Window:Notify(ncfg)
			if type(ncfg) ~= "table" then
				ncfg = { Content = tostring(ncfg) }
			end
			local kind = tostring(ncfg.Type or "Info")
			local accent = (kind == "Success" or kind == "Warning" or kind == "Error") and C[kind] or C.Info
			toastCounter = toastCounter + 1

			local toast = new("Frame", {
				BackgroundColor3 = C.Panel,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = toastCounter,
			}, holder)
			round(toast, 8)
			outline(toast, C.Stroke)
			local accentBar = new("Frame", {
				BackgroundColor3 = accent,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 3, 1, 0),
			}, toast)
			round(accentBar, 2)

			local inner = new("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(1, -12, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
			}, toast)
			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, inner)
			new("UIPadding", {
