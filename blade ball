-- Kittylol Menu: a self-contained replacement for the UI library the script used to
-- download (that URL is dead). It implements exactly the API the script calls:
--   CreateWindow, Window:Toggle / CreateTab / Notify, and on tabs:
--   Section, Toggle, Slider, RangeSlider, Dropdown, Input, ColorPicker
-- Toggle the menu with RightControl or the small "Kittylol" button on the left.
-- If a control's callback errors, the console prints:  [Kittylol Menu] '<name>' callback error: ...
-- ======================================================================================
local KittylolMenuLib = (function()
	local TweenService = game:GetService("TweenService")
	local UserInputService = game:GetService("UserInputService")
	local Players = game:GetService("Players")

	local C = {
		BG = Color3.fromRGB(13, 13, 16),
		Panel = Color3.fromRGB(21, 21, 26),
		Row = Color3.fromRGB(29, 29, 35),
		RowHover = Color3.fromRGB(37, 37, 45),
		Stroke = Color3.fromRGB(50, 50, 60),
		Text = Color3.fromRGB(236, 236, 241),
		Dim = Color3.fromRGB(138, 138, 152),
		Accent = Color3.fromRGB(255, 255, 255),
		AccentText = Color3.fromRGB(12, 12, 14),
		Off = Color3.fromRGB(58, 58, 68),
		Success = Color3.fromRGB(96, 220, 140),
		Info = Color3.fromRGB(125, 170, 255),
		Warning = Color3.fromRGB(255, 200, 85),
		Error = Color3.fromRGB(255, 95, 95),
	}

	-- ---------------------------------------------------------------- helpers
	local function new(class, props, parent)
		local inst = Instance.new(class)
		for k, v in pairs(props) do
			inst[k] = v
		end
		if parent then
			inst.Parent = parent
		end
		return inst
	end

	local function round(inst, radius)
		return new("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
	end

	local function outline(inst, color)
		return new("UIStroke", {
			Color = color or C.Stroke,
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}, inst)
	end

	local function text(parent, str, size, color, font, align)
		return new("TextLabel", {
			BackgroundTransparency = 1,
			Text = tostring(str),
			TextSize = size or 13,
			TextColor3 = color or C.Text,
			Font = font or Enum.Font.GothamMedium,
			TextXAlignment = align or Enum.TextXAlignment.Left,
		}, parent)
	end

	local function tween(inst, props, t)
		TweenService:Create(inst, TweenInfo.new(t or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
	end

	local function safeCall(name, fn, ...)
		if type(fn) ~= "function" then
			return
		end
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[Kittylol Menu] '" .. tostring(name) .. "' callback error: " .. tostring(err))
		end
	end

	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
	end

	local function fmtNum(v)
		local s = string.format("%.3f", v)
		s = string.gsub(s, "%.?0+$", "")
		return s
	end

	-- ------------------------------------------------------- shared drag plumbing
	-- One pair of global input connections serves every slider / draggable window.
	local activeDrag = nil
	local dragHooked = false

	local function hookDrag()
		if dragHooked then
			return
		end
		dragHooked = true
		UserInputService.InputChanged:Connect(function(input)
			if activeDrag
				and (input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch) then
				activeDrag(input)
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			if isPress(input) then
				activeDrag = nil
			end
		end)
	end

	-- onMove(input) runs on press and on every move while the button is held
	local function bindDrag(hit, onMove)
		hookDrag()
		hit.InputBegan:Connect(function(input)
			if isPress(input) then
				activeDrag = onMove
				onMove(input)
			end
		end)
	end

	-- drag `target` by grabbing `handle`; the returned table's .moved tells a click from a drag
	local function makeDraggable(handle, target)
		hookDrag()
		local state = { moved = false }
		handle.InputBegan:Connect(function(input)
			if isPress(input) then
				state.moved = false
				local startMouse = input.Position
				local startPos = target.Position
				activeDrag = function(i)
					local d = i.Position - startMouse
					if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then
						state.moved = true
					end
					target.Position = UDim2.new(
						startPos.X.Scale, startPos.X.Offset + d.X,
						startPos.Y.Scale, startPos.Y.Offset + d.Y
					)
				end
			end
		end)
		return state
	end

	local function hoverable(row, hit)
		hit.MouseEnter:Connect(function()
			tween(row, { BackgroundColor3 = C.RowHover }, 0.1)
		end)
		hit.MouseLeave:Connect(function()
			tween(row, { BackgroundColor3 = C.Row }, 0.1)
		end)
	end

	-- ------------------------------------------------------------------ tab methods
	local TabMethods = {}
