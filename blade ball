		round(row, 6)
		table.insert(tab._items, { frame = row, key = string.lower(tostring(key)), section = false })
		return row
	end

	local function register(tab, cfg, control)
		if cfg.Flag ~= nil then
			tab._win.Flags[cfg.Flag] = control
