    local function refreshEggs()
        pcall(function()
            eggNamesList = {}
            eggTypeMap = {}
            local groupedEggs = {}
            local descendants = workspace:GetDescendants()
            for i = 1, #descendants do
                local descendant = descendants[i]
                if descendant.Name:lower():find("egg") and not isInBase(descendant) then
                    local isInteractable = false
                    local targetPart = nil
                    if descendant:IsA("BasePart") then
                        targetPart = descendant
                        if descendant:FindFirstChildWhichIsA("ProximityPrompt", true) or descendant:FindFirstChild("TouchInterest") then isInteractable = true end
                    elseif descendant:IsA("Model") then
                        targetPart = descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart", true)
                        if descendant:FindFirstChildWhichIsA("ProximityPrompt", true) or descendant:FindFirstChild("TouchInterest", true) then isInteractable = true end
                    end
                    if targetPart and isInteractable then
                        local eggName = descendant.Name
                        local cloverText, cloverScore = getEggCloverValue(descendant)
                        local identifierKey = "🥚 " .. eggName .. " [🍀 " .. (cloverScore > 0 and cloverText or "Normal") .. "]"
                        if not groupedEggs[identifierKey] then
                            groupedEggs[identifierKey] = { BaseName = eggName, Score = cloverScore, Instances = {} }
                        end
                        table.insert(groupedEggs[identifierKey].Instances, descendant)
                    end
                end
            end
            
            local sortableList = {}
            for key, data in pairs(groupedEggs) do
                table.insert(sortableList, { DisplayKey = key .. " (" .. #data.Instances .. ")", BaseName = data.BaseName, Score = data.Score, Instances = data.Instances })
            end
            table.sort(sortableList, function(a, b) return a.Score > b.Score end)
            for i = 1, #sortableList do
                local item = sortableList[i]
                table.insert(eggNamesList, item.DisplayKey)
                eggTypeMap[item.DisplayKey] = { Name = item.BaseName, Instances = item.Instances }
            end
            if #eggNamesList == 0 then table.insert(eggNamesList, "❌ No eggs found on map") end
        end)
    end

