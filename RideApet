local function updateGlobalTop(username)
    pcall(function()
        local headers = {
            ["Content-Type"] = "application/json",
            ["X-Master-Key"] = MASTER_KEY
        }
        
        local getReq = (syn and syn.request) or (http and http.request) or request
        if not getReq then return end
        
        local res = getReq({
            Url = "https://api.jsonbin.io/v3/b/" .. BIN_ID .. "/latest",
            Method = "GET",
            Headers = { ["X-Master-Key"] = MASTER_KEY }
        })
        
        if res and res.StatusCode == 200 then
            local data = HttpService:JSONDecode(res.Body)
            local users = data.record and data.record.users or {}
            
            local found = false
            for _, u in ipairs(users) do
                if u.name == username then
                    u.uses = u.uses + 1
                    found = true
                    break
                end
            end
            
            if not found then
                table.insert(users, { name = username, uses = 1 })
            end
            
            table.sort(users, function(a, b) return a.uses > b.uses end)
            
            getReq({
                Url = "https://api.jsonbin.io/v3/b/" .. BIN_ID,
                Method = "PUT",
                Headers = headers,
                Body = HttpService:JSONEncode({ users = users })
            })
        end
    end)
end

