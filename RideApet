local function LoadMarioLibrary()
    local url = "https://raw.githubusercontent.com/xDTaraZz/Roblox-Scripts/refs/heads/main/ui.lua"
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" then
        local chunk, err = loadstring(body)
        if chunk then
            local libOk, lib = pcall(chunk)
            if libOk then return lib end
        end
    end
    return nil
end

