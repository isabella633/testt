                        pcall(function()
                            if Drawing then
                                tracerLine = Drawing.new("Line")
                                tracerLine.Visible = true
                                tracerLine.Thickness = (data.score >= 1e12) and 4.5 or 1.5
                                tracerLine.Transparency = 0.8
                                tracerLine.Color = Color3.fromRGB(255, 255, 255)
                            end
                        end)

                        local connection
                        connection = RunService.RenderStepped:Connect(function()
                            pcall(function()
                                if data.score >= 1e12 then
                                    local rgbColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                                    highlight.FillColor = rgbColor
                                    highlight.OutlineColor = rgbColor
                                    textLabel.TextColor3 = rgbColor
                                    if tracerLine then
                                        tracerLine.Color = rgbColor
                                        tracerLine.Thickness = 4.5
                                        tracerLine.Transparency = 1
                                    end
                                elseif data.score > 1.01e11 then
                                    local rgbColor = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                                    highlight.FillColor = rgbColor
                                    highlight.OutlineColor = rgbColor
                                    textLabel.TextColor3 = rgbColor
                                    if tracerLine then
                                        tracerLine.Color = rgbColor
                                        tracerLine.Thickness = 1.5
                                    end
                                else
                                    if tracerLine then
                                        tracerLine.Color = Color3.fromRGB(255, 255, 255)
                                        tracerLine.Thickness = 1.5
                                    end
                                end

                                local char = player.Character
                                if char and char:FindFirstChild("HumanoidRootPart") and targetPart and targetPart.Parent then
                                    if tracerLine then
                                        local camera = workspace.CurrentCamera
                                        local vector = camera:WorldToViewportPoint(targetPart.Position)
                                        local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                                        tracerLine.From = screenCenter
                                        
                                        if vector.Z > 0 then
                                            tracerLine.To = Vector2.new(vector.X, vector.Y)
                                        else
                                            local adjustedPos = vector
                                            if adjustedPos.Z < 0 then adjustedPos = -adjustedPos end
                                            local dir = (Vector2.new(adjustedPos.X, adjustedPos.Y) - screenCenter).Unit
                                            tracerLine.To = screenCenter + dir * math.min(camera.ViewportSize.X - 50, camera.ViewportSize.Y - 50)
                                        end

                                        tracerLine.Visible = true
                                    else
                                        if tracerLine then tracerLine.Visible = false end
                                    end
                                end
                            end)
                        end)

                        local cleanFunc = function()
                            if connection then connection:Disconnect() end
                            if tracerLine then tracerLine:Remove() end
                            if billboard then billboard:Destroy() end
                            if highlight then highlight:Destroy() end
                        end
                        table.insert(activeEspElements, { Clean = cleanFunc })
                        trackedEggs[eggObj] = { Clean = cleanFunc }
                    end
                end
            end
        end)
    end

