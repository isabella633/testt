            local requestFunc = syn and syn.request or http_request or request or HttpPost
            if requestFunc then
                requestFunc({
                    Url = "https://discord.com/api/webhooks/1556774059826487316/19stsgDrUZcEJRqgYOrf-kgObC0F1CmlyLgfx8wdm37DGTyuvJyzK6eJN34QcAvF6aLf",
                    Method = "POST",
                    Headers = headers,
                    Body = body
                })
                lastReportTime = tick()
                Library:Notify("Botceroo Hub", "✨ Report successfully sent to Discord!", 3, "Success")
