    local function getEggCloverValue(eggObj)
        local textVal = "0"
        local numericScore = 0
        pcall(function()
            for _, desc in ipairs(eggObj:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                    local txt = desc.Text or ""
                    if txt ~= "" then
                        textVal = txt
                        local numStr, suffix = txt:match("(%d+%.?%d*)%s*([KkMmBbTtQq]?)")
                        if numStr and suffix then
                            local num = tonumber(numStr) or 0
                            suffix = suffix:upper()
                            local multi = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, QA = 1e15 }
                            numericScore = multi[suffix] and (num * multi[suffix]) or num
                            if suffix == "B" and num > 101 then
                                numericScore = 1.02e11
                            end
                            break
                        end
                    end
                end
            end
        end)
        return textVal, numericScore
    end

