function Library:InitWatermark()
	local gui = Instance.new("ScreenGui")
	gui.Name = "GSWatermark"
	gui.ResetOnSpawn = false
	gui.Parent = getHui()
	local f = Instance.new("Frame")
	f.Size = UDim2.new(0, 180, 0, 24)
	f.Position = UDim2.new(1, -190, 0, 10)
	f.BackgroundColor3 = Library.Theme.Panel
	f.BorderSizePixel = 0
	f.Parent = gui
	corner(f, 4)
	stroke(f)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -8, 1, 0)
	lbl.Position = UDim2.new(0, 4, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.TextColor3 = Library.Theme.Text
	lbl.Font = Enum.Font.Code
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = f
	local frames, last = 0, tick()
	Library.Connections[#Library.Connections + 1] = RunService.RenderStepped:Connect(function()
		frames = frames + 1
		if tick() - last >= 1 then
			local ping = 0
			pcall(function()
				ping = math.floor(LP:GetNetworkPing() * 1000)
			end)
			lbl.Text = string.format("%s | %d FPS | %dms", Library.Hub.Game or "GS", frames, ping)
			frames = 0
			last = tick()
		end
	end)
	Library._watermark = gui
end

local function ensureFolder(name)
	if not makefolder then return end
	pcall(function() makefolder(name) end)
end

function Library:SaveConfig(name)
	name = tostring(name or "default")
	ensureFolder(self.ConfigFolder)
	local data = {}
	for k, v in pairs(self.Flags) do
		if typeof(v) == "Color3" then
			data[k] = { __c3 = true, r = v.R, g = v.G, b = v.B }
		else
			data[k] = v
		end
	end
	local ok, enc = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not ok then return false end
	local path = self.ConfigFolder .. "/" .. name .. ".json"
	local w = false
	pcall(function()
		if writefile then
			writefile(path, enc)
			w = true
		end
	end)
	return w
end

function Library:LoadConfig(name)
	name = tostring(name or "default")
	local path = self.ConfigFolder .. "/" .. name .. ".json"
	local raw
	pcall(function()
		if readfile then raw = readfile(path) end
	end)
	if not raw then return false end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(data) ~= "table" then return false end
	for k, v in pairs(data) do
		if type(v) == "table" and v.__c3 then
			v = Color3.new(v.r, v.g, v.b)
		end
		if self.Signals[k] then
			pcall(function() self.Signals[k](v) end)
		else
			self.Flags[k] = v
		end
	end
	return true
end

function Library:DeleteConfig(name)
	name = tostring(name or "default")
	pcall(function()
		if delfile then delfile(self.ConfigFolder .. "/" .. name .. ".json") end
	end)
end

function Library:ConfigExists(name)
	name = tostring(name or "default")
	local ok, raw = pcall(function()
		return readfile and readfile(self.ConfigFolder .. "/" .. name .. ".json")
	end)
	return ok and type(raw) == "string" and #raw > 0
end

function Library:GetConfigs()
	local out = {}
	pcall(function()
		if listfiles then
			for _, f in ipairs(listfiles(self.ConfigFolder) or {}) do
				local n = tostring(f):match("([^/\\]+)%.json$")
				if n then out[#out + 1] = n end
			end
		end
	end)
	table.sort(out)
	return out
end

function Library:Unload()
	if self._unloaded then return end
	self._unloaded = true
	for _, c in ipairs(self.Connections) do
		pcall(function() c:Disconnect() end)
	end
	for _, w in ipairs(self.Windows) do
		pcall(function() w:Destroy() end)
	end
	if self._watermark then
		pcall(function() self._watermark:Destroy() end)
	end
end

