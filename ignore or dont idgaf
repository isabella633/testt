			head.BackgroundTransparency = 1
			head.Text = secName
			head.TextColor3 = Library.Theme.Text
			head.Font = Enum.Font.GothamBold
			head.TextSize = 12
			head.TextXAlignment = Enum.TextXAlignment.Left
			head.Parent = box
			local body = Instance.new("Frame")
			body.Name = "Body"
			body.Size = UDim2.new(1, 0, 0, 0)
			body.AutomaticSize = Enum.AutomaticSize.Y
			body.BackgroundTransparency = 1
			body.Parent = box
			list(body, 4)

			local Section = {}

			function Section:Toggle(text, flag, default, tooltip, callback)
				Library.Flags[flag] = default and true or false
				Library.Defaults[flag] = Library.Flags[flag]
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 26)
				row.BackgroundTransparency = 1
				row.Parent = body
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, -56, 1, 0)
				lbl.BackgroundTransparency = 1
				lbl.Text = text
				lbl.TextColor3 = Library.Theme.Text
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 12
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Parent = row
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(0, 48, 0, 20)
				btn.Position = UDim2.new(1, -48, 0.5, -10)
				btn.BorderSizePixel = 0
				btn.Font = Enum.Font.GothamBold
				btn.TextSize = 11
				btn.Parent = row
				corner(btn, 4)
				local function refresh()
					local on = Library.Flags[flag]
					btn.Text = on and "ON" or "OFF"
					btn.BackgroundColor3 = on and Library.Theme.Success or Library.Theme.Off
					btn.TextColor3 = Color3.new(1, 1, 1)
				end
				refresh()
				local function set(v)
					Library.Flags[flag] = not not v
					refresh()
					if callback then callback(Library.Flags[flag]) end
				end
				Library.Signals[flag] = set
				btn.MouseButton1Click:Connect(function()
					set(not Library.Flags[flag])
				end)
				return { Set = set }
			end

			function Section:Slider(text, flag, min, max, default, increment, tooltip, callback)
				min, max = min or 0, max or 100
				increment = increment or 1
				default = default or min
				Library.Flags[flag] = default
				Library.Defaults[flag] = default
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 40)
				row.BackgroundTransparency = 1
				row.Parent = body
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, -50, 0, 16)
				lbl.BackgroundTransparency = 1
				lbl.Text = text
				lbl.TextColor3 = Library.Theme.Text
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 12
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Parent = row
				local val = Instance.new("TextLabel")
				val.Size = UDim2.new(0, 44, 0, 16)
				val.Position = UDim2.new(1, -44, 0, 0)
				val.BackgroundTransparency = 1
				val.Text = tostring(default)
				val.TextColor3 = Library.Theme.Dim
				val.Font = Enum.Font.Gotham
				val.TextSize = 11
				val.TextXAlignment = Enum.TextXAlignment.Right
				val.Parent = row
				local bar = Instance.new("Frame")
				bar.Size = UDim2.new(1, 0, 0, 6)
				bar.Position = UDim2.new(0, 0, 0, 24)
				bar.BackgroundColor3 = Library.Theme.Off
				bar.BorderSizePixel = 0
				bar.Parent = row
				corner(bar, 3)
				local fill = Instance.new("Frame")
				fill.Size = UDim2.new(math.clamp((default - min) / (max - min), 0, 1), 0, 1, 0)
				fill.BackgroundColor3 = Library.Theme.Accent
				fill.BorderSizePixel = 0
				fill.Parent = bar
				corner(fill, 3)
				local sliding = false
				local function apply(v, fire)
					v = math.clamp(v, min, max)
					v = math.floor(v / increment + 0.5) * increment
					Library.Flags[flag] = v
					fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
					val.Text = tostring(v)
					if fire and callback then callback(tostring(v)) end
				end
				Library.Signals[flag] = function(v)
					apply(tonumber(v) or default, true)
				end
				bar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
						local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
						apply(min + (max - min) * rel, true)
					end
				end)
				return row
			end

			function Section:Dropdown(text, flag, options, default, tooltip, callback)
				options = options or {}
				default = default or options[1]
				Library.Flags[flag] = default
				Library.Defaults[flag] = default
