				btn.Size = UDim2.new(0.52, 0, 0, 22)
				btn.Position = UDim2.new(0.48, 0, 0.5, -11)
				btn.BackgroundColor3 = Library.Theme.Off
				btn.Text = tostring(default)
				btn.TextColor3 = Library.Theme.Text
				btn.Font = Enum.Font.Gotham
				btn.TextSize = 11
				btn.BorderSizePixel = 0
				btn.Parent = row
				corner(btn, 4)
				local idx = 1
				for i, o in ipairs(options) do
					if o == default then idx = i break end
				end
				local function set(v)
					Library.Flags[flag] = v
					btn.Text = tostring(v)
					if callback then callback(v) end
				end
				Library.Signals[flag] = set
				btn.MouseButton1Click:Connect(function()
					idx = idx % #options + 1
					set(options[idx])
				end)
				return {
					Set = set,
					Refresh = function(_, opts, def)
						options = opts or options
						if def then set(def) end
					end,
					GetSelected = function()
						return Library.Flags[flag]
					end,
				}
			end

			function Section:ColorPicker(text, flag, default, tooltip, callback)
				default = default or Color3.new(1, 1, 1)
				Library.Flags[flag] = default
				Library.Defaults[flag] = default
				local presets = {
					Color3.fromRGB(0, 255, 0),
					Color3.fromRGB(0, 170, 255),
					Color3.fromRGB(255, 255, 0),
					Color3.fromRGB(255, 60, 60),
					Color3.fromRGB(255, 100, 255),
					Color3.fromRGB(255, 255, 255),
					Color3.fromRGB(90, 140, 255),
				}
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 26)
				row.BackgroundTransparency = 1
				row.Parent = body
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, -36, 1, 0)
				lbl.BackgroundTransparency = 1
				lbl.Text = text
				lbl.TextColor3 = Library.Theme.Text
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 12
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Parent = row
				local sw = Instance.new("TextButton")
				sw.Size = UDim2.new(0, 28, 0, 20)
				sw.Position = UDim2.new(1, -28, 0.5, -10)
				sw.BackgroundColor3 = default
				sw.Text = ""
				sw.BorderSizePixel = 0
				sw.Parent = row
				corner(sw, 4)
				local pi = 1
				local function set(c)
					Library.Flags[flag] = c
					sw.BackgroundColor3 = c
					if callback then callback(c) end
				end
				Library.Signals[flag] = set
				sw.MouseButton1Click:Connect(function()
					pi = pi % #presets + 1
					set(presets[pi])
				end)
				return row
			end

			function Section:Button(text, tooltip, callback)
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 28)
				row.BackgroundTransparency = 1
				row.Parent = body
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, 0, 0, 26)
				btn.BackgroundColor3 = Library.Theme.Off
				btn.Text = text
				btn.TextColor3 = Library.Theme.Text
				btn.Font = Enum.Font.GothamBold
				btn.TextSize = 12
				btn.BorderSizePixel = 0
				btn.Parent = row
				corner(btn, 4)
				btn.MouseButton1Click:Connect(function()
					if callback then callback() end
				end)
				return btn
			end

			function Section:TextBox(text, flag, placeholder, tooltip, callback)
				Library.Flags[flag] = ""
				Library.Defaults[flag] = ""
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 48)
				row.BackgroundTransparency = 1
				row.Parent = body
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, 0, 0, 16)
				lbl.BackgroundTransparency = 1
				lbl.Text = text
				lbl.TextColor3 = Library.Theme.Text
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 12
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Parent = row
				local box = Instance.new("TextBox")
				box.Size = UDim2.new(1, 0, 0, 24)
				box.Position = UDim2.new(0, 0, 0, 20)
				box.BackgroundColor3 = Library.Theme.Off
				box.Text = ""
				box.PlaceholderText = placeholder or ""
				box.TextColor3 = Library.Theme.Text
				box.PlaceholderColor3 = Library.Theme.Dim
				box.Font = Enum.Font.Gotham
				box.TextSize = 12
				box.ClearTextOnFocus = false
				box.BorderSizePixel = 0
				box.Parent = row
				corner(box, 4)
				local function set(v)
					Library.Flags[flag] = tostring(v or "")
					box.Text = Library.Flags[flag]
				end
				Library.Signals[flag] = set
				box.FocusLost:Connect(function(enter)
					Library.Flags[flag] = box.Text
					if callback then callback(box.Text) end
				end)
				return box
			end

			function Section:Label(text)
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, 0, 0, 18)
				lbl.BackgroundTransparency = 1
				lbl.Text = text
				lbl.TextColor3 = Library.Theme.Dim
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 11
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Parent = body
				return {
					Set = function(_, t) lbl.Text = t end,
					SetColor = function(_, c) lbl.TextColor3 = c end,
				}
			end

			function Section:Keybind(text, flag, defaultKey, mode, tooltip, callback)
				Library.Flags[flag] = { Key = defaultKey or Enum.KeyCode.Unknown, Mode = mode or "Toggle" }
				Library.Defaults[flag] = Library.Flags[flag]
				local active = false
				local row = Instance.new("Frame")
				row.Size = UDim2.new(1, 0, 0, 26)
				row.BackgroundTransparency = 1
				row.Parent = body
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.new(1, -70, 1, 0)
				lbl.BackgroundTransparency = 1
				lbl.Text = text
				lbl.TextColor3 = Library.Theme.Text
				lbl.Font = Enum.Font.Gotham
				lbl.TextSize = 12
				lbl.TextXAlignment = Enum.TextXAlignment.Left
				lbl.Parent = row
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(0, 64, 0, 20)
				btn.Position = UDim2.new(1, -64, 0.5, -10)
				btn.BackgroundColor3 = Library.Theme.Off
				btn.Text = (defaultKey and defaultKey.Name) or "None"
				btn.TextColor3 = Library.Theme.Text
				btn.Font = Enum.Font.Gotham
				btn.TextSize = 11
				btn.BorderSizePixel = 0
				btn.Parent = row
				corner(btn, 4)
				local listening = false
				btn.MouseButton1Click:Connect(function()
					listening = true
					btn.Text = "..."
				end)
				Library.Connections[#Library.Connections + 1] = UserInputService.InputBegan:Connect(function(input, gp)
					if listening and input.UserInputType == Enum.UserInputType.Keyboard then
						listening = false
						Library.Flags[flag].Key = input.KeyCode
						btn.Text = input.KeyCode.Name
						return
					end
					if gp then return end
					local bind = Library.Flags[flag]
					if bind and bind.Key == input.KeyCode then
						if bind.Mode == "Toggle" then
							active = not active
							if callback then callback(active) end
						elseif bind.Mode == "Hold" then
							active = true
							if callback then callback(true) end
						elseif bind.Mode == "Always" then
							if callback then callback(true) end
						end
					end
				end)
				Library.Connections[#Library.Connections + 1] = UserInputService.InputEnded:Connect(function(input)
					local bind = Library.Flags[flag]
					if bind and bind.Mode == "Hold" and bind.Key == input.KeyCode then
						active = false
						if callback then callback(false) end
					end
				end)
				return {
					SetKey = function(_, k)
						Library.Flags[flag].Key = k
						btn.Text = k.Name
					end,
				}
			end

			return Section
		end
		return Tab
	end

	Library.Connections[#Library.Connections + 1] = UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.RightShift then
			gui.Enabled = not gui.Enabled
		end
	end)

	return Window
end

return Library
