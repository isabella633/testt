		btn.Size = UDim2.new(1, 0, 0, 30)
		btn.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
		btn.Text = name
		btn.TextColor3 = Library.Theme.Dim
		btn.Font = Enum.Font.Gotham
		btn.TextSize = 12
		btn.BorderSizePixel = 0
		btn.Parent = side
		corner(btn, 4)

		local function select()
			for n, t in pairs(tabs) do
				t.page.Visible = (n == name)
				if t.btn then
					t.btn.BackgroundColor3 = (n == name) and Color3.fromRGB(50, 60, 90) or Color3.fromRGB(28, 28, 36)
					t.btn.TextColor3 = (n == name) and Library.Theme.Text or Library.Theme.Dim
				end
			end
			current = name
		end
		btn.MouseButton1Click:Connect(select)
		tabs[name] = { page = page, btn = btn, left = leftCol, right = rightCol }
		if not current then select() end

		local Tab = {}
		function Tab:Section(secName, sideName)
			local parent = (sideName == "Right") and rightCol or leftCol
			local box = Instance.new("Frame")
			box.Size = UDim2.new(1, 0, 0, 0)
			box.AutomaticSize = Enum.AutomaticSize.Y
			box.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
			box.BorderSizePixel = 0
			box.Parent = parent
			corner(box, 6)
			pad(box, 4, 6, 8, 6)
