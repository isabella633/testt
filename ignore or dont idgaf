local function getHui()
	if gethui then return gethui() end
	local ok, r = pcall(function() return CoreGui end)
	if ok then return r end
	return LP:WaitForChild("PlayerGui")
end

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	c.Parent = o
	return c
end

local function stroke(o, col, t)
	local s = Instance.new("UIStroke")
	s.Color = col or Library.Theme.Stroke
	s.Thickness = t or 1
	s.Parent = o
	return s
end

local function pad(o, t, r, b, l)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, t or 0)
	p.PaddingRight = UDim.new(0, r or 0)
	p.PaddingBottom = UDim.new(0, b or 0)
	p.PaddingLeft = UDim.new(0, l or 0)
	p.Parent = o
	return p
end

local function list(o, gap)
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, gap or 4)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = o
	return l
end

local function tween(o, props, t)
	TweenService:Create(o, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

