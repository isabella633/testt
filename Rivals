local tweenService = game:GetService("TweenService")
local userInputService = game:GetService("UserInputService")
local runService = game:GetService("RunService")
local players = game:GetService("Players")
local coreGui = game:GetService("CoreGui")

local function makeTextButton()
  local playerGui

  if not pcall(function() playerGui = coreGui end) or not playerGui then
    playerGui = players.LocalPlayer:WaitForChild("PlayerGui")
  end

  local scriptFarmerPremiumWatermark = playerGui:FindFirstChild("ScriptFarmerPremiumWatermark")

  if scriptFarmerPremiumWatermark then
    scriptFarmerPremiumWatermark:Destroy()
  end

  local scriptFarmerPremiumWatermark2 = Instance.new("ScreenGui")
  scriptFarmerPremiumWatermark2.Name = "ScriptFarmerPremiumWatermark"
  scriptFarmerPremiumWatermark2.ResetOnSpawn = false
  scriptFarmerPremiumWatermark2.IgnoreGuiInset = true
  scriptFarmerPremiumWatermark2.DisplayOrder = 999999
  scriptFarmerPremiumWatermark2.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  scriptFarmerPremiumWatermark2.Parent = playerGui

  local holder = Instance.new("Frame")
  holder.Name = "Holder"
  holder.Parent = scriptFarmerPremiumWatermark2
  holder.AnchorPoint = Vector2.new(1, 0)
  holder.Position = UDim2.new(1, -10, 0, 10)
  holder.Size = UDim2.new(0, 190, 0, 42)
  holder.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
  holder.BackgroundTransparency = 0.05
  holder.BorderSizePixel = 0
  holder.ZIndex = 10

  local uiCorner = Instance.new("UICorner")
  uiCorner.CornerRadius = UDim.new(0, 10)
  uiCorner.Parent = holder

  local uiStroke = Instance.new("UIStroke")
  uiStroke.Parent = holder
  uiStroke.Color = Color3.fromRGB(210, 210, 210)
  uiStroke.Thickness = 1.2
  uiStroke.Transparency = 0.12

  local uiGradient = Instance.new("UIGradient")
  uiGradient.Parent = holder
  uiGradient.Rotation = 15

  uiGradient.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
    ColorSequenceKeypoint.new(0.45, Color3.fromRGB(248, 248, 248)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(235, 235, 235)),
  })

  local shadow = Instance.new("ImageLabel")
  shadow.Name = "Shadow"
  shadow.Parent = holder
  shadow.BackgroundTransparency = 1
  shadow.AnchorPoint = Vector2.new(0.5, 0.5)
  shadow.Position = UDim2.new(0.5, 0, 0.5, 4)
  shadow.Size = UDim2.new(1, 16, 1, 16)
  shadow.ZIndex = 0
  shadow.Image = "rbxassetid://1316045217"
  shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
  shadow.ImageTransparency = 0.88
  shadow.ScaleType = Enum.ScaleType.Slice
  shadow.SliceCenter = Rect.new(10, 10, 118, 118)

  local topLine = Instance.new("Frame")
  topLine.Name = "TopLine"
  topLine.Parent = holder
  topLine.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
  topLine.BorderSizePixel = 0
  topLine.Position = UDim2.new(0, 0, 0, 0)
  topLine.Size = UDim2.new(1, 0, 0, 2)
  topLine.ZIndex = 11

  local uiCorner2 = Instance.new("UICorner")
  uiCorner2.CornerRadius = UDim.new(0, 10)
  uiCorner2.Parent = topLine

  local iconBg = Instance.new("Frame")
  iconBg.Name = "IconBg"
  iconBg.Parent = holder
  iconBg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
  iconBg.BackgroundTransparency = 0.1
  iconBg.BorderSizePixel = 0
  iconBg.Position = UDim2.new(0, 6, 0, 6)
  iconBg.Size = UDim2.new(0, 30, 0, 30)
  iconBg.ZIndex = 12

  local uiCorner3 = Instance.new("UICorner")
  uiCorner3.CornerRadius = UDim.new(0, 8)
  uiCorner3.Parent = iconBg

  local uiStroke2 = Instance.new("UIStroke")
  uiStroke2.Parent = iconBg
  uiStroke2.Color = Color3.fromRGB(220, 220, 220)
  uiStroke2.Transparency = 0.18
  uiStroke2.Thickness = 1

  local customLogo = Instance.new("ImageLabel")
  customLogo.Name = "CustomLogo"
  customLogo.Parent = iconBg
  customLogo.BackgroundTransparency = 1
  customLogo.AnchorPoint = Vector2.new(0.5, 0.5)
  customLogo.Position = UDim2.new(0.5, 0, 0.5, 0)
  customLogo.Size = UDim2.new(1, 0, 1, 0)
  customLogo.ScaleType = Enum.ScaleType.Stretch
  customLogo.ZIndex = 13

  local uiCorner4 = Instance.new("UICorner")
  uiCorner4.CornerRadius = UDim.new(0, 8)
  uiCorner4.Parent = customLogo

  task.spawn(function()
    pcall(function()
      if isfile and writefile and getcustomasset then
        if not isfile("SFCustomLogo.png") then
          writefile(
            "SFCustomLogo.png", (game:HttpGet("https://i.postimg.cc/Dz19fdsW/images.png"))
          )
        end

        customLogo.Image = getcustomasset("SFCustomLogo.png")
      end
    end)
  end)

  local textLabel = Instance.new("TextLabel")
  textLabel.Parent = holder
  textLabel.BackgroundTransparency = 1
  textLabel.Position = UDim2.new(0, 42, 0, 6)
  textLabel.Size = UDim2.new(0, 80, 0, 14)
  textLabel.Font = Enum.Font.GothamBold
  textLabel.Text = "ScriptFarmer"
  textLabel.TextColor3 = Color3.fromRGB(20, 20, 20)
  textLabel.TextSize = 12
  textLabel.TextXAlignment = Enum.TextXAlignment.Left
  textLabel.ZIndex = 13

  local textLabel2 = Instance.new("TextLabel")
  textLabel2.Parent = holder
  textLabel2.BackgroundTransparency = 1
  textLabel2.Position = UDim2.new(0, 42, 0, 21)
  textLabel2.Size = UDim2.new(0, 80, 0, 12)
  textLabel2.Font = Enum.Font.GothamMedium
  textLabel2.Text = "FPS: 0"
  textLabel2.TextColor3 = Color3.fromRGB(110, 110, 110)
  textLabel2.TextSize = 10
  textLabel2.TextXAlignment = Enum.TextXAlignment.Left
  textLabel2.ZIndex = 13

  local textButton = Instance.new("TextButton")
  textButton.Parent = holder
  textButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
  textButton.BackgroundTransparency = 0.05
  textButton.BorderSizePixel = 0
  textButton.Position = UDim2.new(1, -66, 0, 8)
  textButton.Size = UDim2.new(0, 60, 0, 26)
  textButton.Font = Enum.Font.GothamBold
  textButton.Text = "Discord"
  textButton.TextColor3 = Color3.fromRGB(40, 40, 40)
  textButton.TextSize = 11
  textButton.AutoButtonColor = false
  textButton.ZIndex = 13

  local uiCorner5 = Instance.new("UICorner")
  uiCorner5.CornerRadius = UDim.new(0, 6)
  uiCorner5.Parent = textButton

  local uiStroke3 = Instance.new("UIStroke")
  uiStroke3.Parent = textButton
  uiStroke3.Color = Color3.fromRGB(220, 220, 220)
  uiStroke3.Transparency = 0.15
  uiStroke3.Thickness = 1

  local textLabel3 = Instance.new("TextLabel")
  textLabel3.Parent = holder
  textLabel3.BackgroundTransparency = 1
  textLabel3.Position = UDim2.new(1, -66, 0, 36)
  textLabel3.Size = UDim2.new(0, 60, 0, 8)
  textLabel3.Font = Enum.Font.Gotham
  textLabel3.Text = ""
  textLabel3.TextColor3 = Color3.fromRGB(100, 100, 100)
  textLabel3.TextSize = 8
  textLabel3.TextXAlignment = Enum.TextXAlignment.Center
  textLabel3.ZIndex = 13

  local frame = Instance.new("Frame")
  frame.Parent = holder
  frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
  frame.BackgroundTransparency = 0.6
  frame.BorderSizePixel = 0
  frame.Rotation = 18
  frame.Position = UDim2.new(0, -80, 0, -20)
  frame.Size = UDim2.new(0, 40, 0, 100)
  frame.ZIndex = 12

  local uiCorner6 = Instance.new("UICorner")
  uiCorner6.CornerRadius = UDim.new(1, 0)
  uiCorner6.Parent = frame

  task.spawn(function()
    while scriptFarmerPremiumWatermark2.Parent do
      local create = tweenService:Create(frame, TweenInfo.new(
        1.8, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut
      ), { Position = UDim2.new(0, 220, 0, -20) })

      create:Play()
      create.Completed:Wait()

      task.wait(1.5)
      frame.Position = UDim2.new(0, -80, 0, -20)
      task.wait(3)
    end
  end)

  textButton.MouseEnter:Connect(function()
    tweenService:Create(textButton, TweenInfo.new(0.15), {
      BackgroundColor3 = Color3.fromRGB(235, 235, 235),
    }):Play()
  end)

  textButton.MouseLeave:Connect(function()
    tweenService:Create(textButton, TweenInfo.new(0.15), {
      BackgroundColor3 = Color3.fromRGB(255, 255, 255),
    }):Play()
  end)

  textButton.MouseButton1Click:Connect(function()
    local v1 = false

    pcall(function()
      if type(setclipboard) == "function" then
        setclipboard("https://discord.gg/7q2TvZ9GYX")
        v1 = true
      end
    end)

    if v1 then
      textLabel3.Text = "Copied"
      textLabel3.TextColor3 = Color3.fromRGB(45, 180, 85)
    else
      textLabel3.Text = "Error"
      textLabel3.TextColor3 = Color3.fromRGB(200, 60, 60)
    end

    textButton.Text = "Done!"

    task.delay(1.3, function()
      if textButton then
        textButton.Text = "Discord"
      end
    end)

    task.delay(2.2, function()
      if textLabel3 then
        textLabel3.Text = ""
      end
    end)
  end)

  local v2 = false
  local position, position2

  local function f1(input)
    local v3 = input.Position - position

    holder.Position = UDim2.new(
      position2.X.Scale, position2.X.Offset + v3.X, position2.Y.Scale, position2.Y.Offset + v3.Y
    )
  end

  holder.InputBegan:Connect(function(input2)
    if input2.UserInputType == Enum.UserInputType.MouseButton1
      or input2.UserInputType == Enum.UserInputType.Touch then
      v2 = true
      position = input2.Position
      position2 = holder.Position

      input2.Changed:Connect(function()
        if input2.UserInputState == Enum.UserInputState.End then
          v2 = false
        end
      end)
    end
  end)

  local v4

  holder.InputChanged:Connect(function(input3)
    if input3.UserInputType == Enum.UserInputType.MouseMovement
      or input3.UserInputType == Enum.UserInputType.Touch then
      v4 = input3
    end
  end)

  userInputService.InputChanged:Connect(function(input4)
    if input4 == v4 and v2 then
      f1(input4)
    end
  end)

  local v5 = 0
  local v6 = tick()

  runService.RenderStepped:Connect(function()
    v5 = v5 + 1
    local v7 = tick()

    if v7 - v6 >= 1 then
      textLabel2.Text = "FPS: " .. tostring(v5)
      v5 = 0
      v6 = v7
    end
  end)
end

makeTextButton()

task.spawn(function()
	local invite = "https://discord.gg/CAHeSyFwWU"
	local code = "CAHeSyFwWU"

	pcall(function()
		if setclipboard then
			setclipboard(invite)
		elseif toclipboard then
			toclipboard(invite)
		end
	end)

	pcall(function()
		local proto = "discord://-/invite/" .. code
		if syn and syn.request then
			syn.request({Url = proto, Method = "GET"})
		elseif request then
			request({Url = proto, Method = "GET"})
		elseif http_request then
			http_request({Url = proto, Method = "GET"})
		end
	end)

	pcall(function()
		if syn and syn.request then
			syn.request({Url = invite, Method = "GET"})
		elseif request then
			request({Url = invite, Method = "GET"})
		end
	end)

	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Discord",
			Text = "Invite copied / opening…",
			Duration = 4
		})
	end)
end)
