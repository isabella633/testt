local function clearAbilityEffects()
    if not State.antiAbilities then return end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not root or not humanoid then
        State.antiAbilityCharacter = nil
        State.antiAbilityLastCFrame = nil
        State.antiAbilityLastPlaying = false
        clearBlindEffect()
        return
    end

    setCharacterQueryProtection(character, true)
    setAbilityTouchProtection(character, true)

    -- Dynamic Tag Scanner (Auto-detects ANY newly added debuff tags)
    local activeTags = CollectionService:GetTags(character)
    for _, tag in ipairs(activeTags) do
        local tagLower = string.lower(tag)
        for _, pattern in ipairs(harmfulTagPatterns) do
            if string.find(tagLower, pattern, 1, true) then
                CollectionService:RemoveTag(character, tag)
                State.antiAbilityTagsRemoved += 1
                State.antiAbilityLastBlocked = tag
                break
            end
        end
    end

    -- Dynamic Object & Physics Cleaner (Auto-detects newly added debuff models/forces)
    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") and object.Anchored then
            object.Anchored = false
            State.antiAbilityLastBlocked = "Freeze / Time Freeze"
        else
            local objNameLower = string.lower(object.Name)
            local isHarmfulObject = false
            for _, pattern in ipairs(harmfulObjectPatterns) do
                if string.find(objNameLower, pattern, 1, true) then
                    isHarmfulObject = true
                    break
                end
            end
            
            if isHarmfulObject and (object:IsA("Model") or object:IsA("Folder") or object:IsA("BasePart")) then
                object:Destroy()
                State.antiAbilityForcesRemoved += 1
            elseif (object:IsA("BodyVelocity") or object:IsA("BodyPosition") or object:IsA("BodyAngularVelocity")
                or object:IsA("LinearVelocity") or object:IsA("AngularVelocity") or object:IsA("VectorForce"))
                and object.Name ~= "WingsBodyVelocity" and object.Name ~= "WingsBodyGyro" then
                object:Destroy()
                State.antiAbilityForcesRemoved += 1
                State.antiAbilityLastBlocked = "Fling / knockback"
            elseif (object:IsA("JointInstance") or object:IsA("Constraint")) and jointConnectsOutsideCharacter(object, character) then
                object:Destroy()
                State.antiAbilityForcesRemoved += 1
                State.antiAbilityLastBlocked = "Chain / Human Shield"
            end
        end
    end

    if humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
        humanoid.Health = humanoid.MaxHealth
        State.antiAbilityLastBlocked = "Ability damage"
    end
    if not State.autoWinActive then
