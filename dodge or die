-- Auto Code Redeem Feed Scraper
local fallbackCodes = {"1KCCU", "250K", "DODGE"}
local function discoverActiveCodes()
    local discovered = {}
    local seen = {}
    local function add(code)
        code = tostring(code or ""):match("^%s*(.-)%s*$")
        if code ~= "" and #code <= 50 and not seen[code] then
            seen[code] = true
            discovered[#discovered + 1] = code
        end
    end

    local ok, html = pcall(function()
        return __CMHUB_GET_TEXT_V1(State.codeFeedUrl)
    end)
    if ok and typeof(html) == "string" then
        for code in string.gmatch(html, 'data%-expired="false".-data%-copy="([^"]+)"') do
            add(code:gsub("&amp;", "&"):gsub("&quot;", '"'):gsub("&#39;", "'"))
        end
    end
    for _, code in ipairs(fallbackCodes) do add(code) end
    return discovered, ok
end

