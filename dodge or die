    State.codeBusy = true
    State.lastCodeStatus = "Checking for new codes"

    task.spawn(function()
        local ok, status = pcall(function()
            local codes, feedOnline = discoverActiveCodes()
            State.codesDiscovered = #codes
            local remote = resolveSafeRemote("RedeemCode")
            if not remote then return "RedeemCode remote unavailable" end

            local newAttempts = 0
            local redeemed = 0
            for _, code in ipairs(codes) do
                if not State.codeAttempts[code] then
                    humanDelay(0.3, 0.6)
                    local callOk, accepted, message = pcall(function()
                        return remote:InvokeServer(code)
                    end)
                    if callOk then
                        State.codeAttempts[code] = {
                            accepted = accepted == true,
                            message = tostring(message or ""),
                            attemptedAt = os.time(),
                        }
                        newAttempts += 1
                        State.lastCode = code
                        if accepted then
                            redeemed += 1
                            State.codesRedeemed += 1
                            State.lastCodeStatus = "Redeemed " .. code
                        else
                            State.lastCodeStatus = string.format("%s: %s", code, tostring(message or "already claimed / inactive"))
                        end
                    end
                end
            end

            if redeemed > 0 then
                return string.format("Redeemed %d new code(s)", redeemed)
            elseif newAttempts > 0 then
                return string.format("Checked %d new code(s)", newAttempts)
            elseif feedOnline then
                return string.format("Up to date - %d active code(s)", #codes)
            end
            return string.format("Feed offline - fallback list checked (%d)", #codes)
        end)
        State.lastCodeStatus = ok and status or "Code scan failed"
        State.codeBusy = false
    end)
end)

