local function resolveSafeRemote(remoteName)
    local ok, upvalues = pcall(debug.getupvalues, SafeNet.get)
    if not ok or not upvalues then return nil end
    local registry = nil
    local decoder = nil
    for _, value in pairs(upvalues) do
        if typeof(value) == "table" then
            local remoteCount = 0
            for _, entry in pairs(value) do
                if typeof(entry) == "Instance" and (entry:IsA("RemoteEvent") or entry:IsA("RemoteFunction") or entry:IsA("UnreliableRemoteEvent")) then
                    remoteCount += 1
                end
            end
            if remoteCount > 10 then registry = value end
        elseif typeof(value) == "function" and string.find(debug.info(value, "s"), "safe-net.enc", 1, true) then
            decoder = value
        end
    end
    if not registry or not decoder then return nil end
    for encodedName, remote in pairs(registry) do
        local okDec, decodedName = pcall(decoder, encodedName)
        if okDec and decodedName == remoteName then return remote end
    end
    return nil
end

