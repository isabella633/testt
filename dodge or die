    if State.crateModule then return State.crateModule end
    local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
    local gui = playerScripts and playerScripts:FindFirstChild("GUI")
    local handler = gui and gui:FindFirstChild("ToolCrateHandling")
    local moduleScript = handler and handler:FindFirstChild("ToolCrateLocalModule")
    if not moduleScript then return nil end
    local ok, module = pcall(require, moduleScript)
