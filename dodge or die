-- Dynamic Heartbeat Anticheat Connection Cleaner
local function installHitDetectionBypass()
    local getcon = getconnections or function() return {} end
    local anticheatKeywords = {"hitdetection", "anticheat", "sanity", "checker", "detector", "security", "monitor", "cheat"}
    
    for _, signal in ipairs({RunService.Heartbeat, RunService.Stepped, RunService.RenderStepped}) do
        for _, connection in ipairs(getcon(signal)) do
            local fn = connection.Function
            local source = fn and debug.info(fn, "s") or ""
            local sourceLower = string.lower(source)
            
            local isAnticheat = false
            for _, kw in ipairs(anticheatKeywords) do
                if string.find(sourceLower, kw, 1, true) then
                    isAnticheat = true
                    break
                end
            end
            
            if connection.Enabled and isAnticheat then
                local tracked = false
                for _, existing in ipairs(State.hitDetectionConnections) do
                    if existing == connection then tracked = true break end
                end
                if not tracked then
                    connection:Disable()
                    State.hitDetectionConnections[#State.hitDetectionConnections + 1] = connection
                    State.hitDetectionDisabled += 1
                end
            end
        end
    end
end

