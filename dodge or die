local function setAntiAfk(enabled)
    State.antiAfk = enabled
    local getcon = getconnections or function() return {} end
    if enabled then
        for _, connection in ipairs(getcon(LocalPlayer.Idled)) do
            local alreadyTracked = false
            for _, tracked in ipairs(State.antiAfkConnections) do
                if tracked == connection then alreadyTracked = true break end
            end
            if not alreadyTracked then
                connection:Disable()
                table.insert(State.antiAfkConnections, connection)
            end
        end
    else
        for _, connection in ipairs(State.antiAfkConnections) do
            pcall(function() connection:Enable() end)
        end
        table.clear(State.antiAfkConnections)
    end
end

