env.__CM_DODGE_OR_DIE_CLEANUP = function()
    if State.connection then State.connection:Disconnect() end
    if State.autoWinConnection then State.autoWinConnection:Disconnect() end
    if State.voteConnection then State.voteConnection:Disconnect() end
    if State.upgradeConnection then State.upgradeConnection:Disconnect() end
    if State.spinConnection then State.spinConnection:Disconnect() end
    if State.questConnection then State.questConnection:Disconnect() end
    if State.battlePassConnection then State.battlePassConnection:Disconnect() end
    if State.codeConnection then State.codeConnection:Disconnect() end
    if State.crateConnection then State.crateConnection:Disconnect() end
    if State.crateResultConnection then State.crateResultConnection:Disconnect() end
    if State.antiAbilityConnection then State.antiAbilityConnection:Disconnect() end
    if State.visualConnection then State.visualConnection:Disconnect() end
    if State.movementConnection then State.movementConnection:Disconnect() end
    if State.jumpConnection then State.jumpConnection:Disconnect() end
    if State.autoRejoinConnection then State.autoRejoinConnection:Disconnect() end
    if State.serverHopConnection then State.serverHopConnection:Disconnect() end
    uninstallInstantCrateOpen()
    setAntiAfk(false)
    State.antiAbilities = false
    deactivateAutoWin(LocalPlayer.Character)
    local character = LocalPlayer.Character
    if character then
        setCharacterQueryProtection(character, false)
        setAbilityTouchProtection(character, false)
    end
    clearBallEsp()
    clearPlayerEsp()
    restoreMovement()
    restoreVisualState()
    if env.__CM_DODGE_OR_DIE_STATE == State then
        env.__CM_DODGE_OR_DIE_STATE = nil
        env.__CM_DODGE_OR_DIE_CLEANUP = nil
    end
end

