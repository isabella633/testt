-- Player ESP Mechanics
local function destroyPlayerEsp(target)
    local objects = State.playerEspObjects[target]
    if not objects then return end
    if objects.highlight then objects.highlight:Destroy() end
    if objects.billboard then objects.billboard:Destroy() end
    State.playerEspObjects[target] = nil
end

local function clearPlayerEsp()
    for target in pairs(State.playerEspObjects) do
        destroyPlayerEsp(target)
    end
end

local function updatePlayerEsp(target, localRoot)
    if target == LocalPlayer then return end
    local character = target.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        destroyPlayerEsp(target)
        return
    end

    local distance = (root.Position - localRoot.Position).Magnitude
    local objects = State.playerEspObjects[target]
    if not objects or objects.character ~= character then
        destroyPlayerEsp(target)
        local color = target.Team ~= nil and target.Team == LocalPlayer.Team
            and Color3.fromRGB(70, 255, 120) or Color3.fromRGB(255, 85, 85)
        local highlight = Instance.new("Highlight")
        highlight.Name = "CM_PlayerESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = color
        highlight.FillTransparency = 0.72
        highlight.OutlineColor = color
        highlight.OutlineTransparency = 0
        highlight.Parent = character

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "CM_PlayerInfo"
        billboard.Adornee = root
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.fromOffset(220, 42)
        billboard.StudsOffset = Vector3.new(0, 3.3, 0)
        billboard.Parent = root

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.fromScale(1, 1)
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.TextSize = 14
        label.Parent = billboard

        objects = {character = character, highlight = highlight, billboard = billboard, label = label}
        State.playerEspObjects[target] = objects
    end

    local visible = distance <= State.playerEspDistance
    objects.highlight.Enabled = visible
    objects.billboard.Enabled = visible
    objects.label.Text = string.format("%s | %dm | %d HP", target.DisplayName, math.floor(distance + 0.5), math.floor(humanoid.Health + 0.5))
end

-- Visual Overrides
local function captureVisualState()
    if State.lightingSnapshot then return end
    State.lightingSnapshot = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        FogEnd = Lighting.FogEnd,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        GlobalShadows = Lighting.GlobalShadows,
    }
    pcall(function() State.originalQualityLevel = settings().Rendering.QualityLevel end)
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") then
            State.postEffectSnapshot[effect] = effect.Enabled
        end
    end
end

local function applyVisualState()
    if not State.fullbright and not State.lowGraphics then return end
    captureVisualState()
    local original = State.lightingSnapshot
    Lighting.Brightness = State.fullbright and 3 or original.Brightness
    Lighting.ClockTime = State.fullbright and 14 or original.ClockTime
    Lighting.FogEnd = State.fullbright and 1000000 or original.FogEnd
    Lighting.Ambient = State.fullbright and Color3.fromRGB(180, 180, 180) or original.Ambient
    Lighting.OutdoorAmbient = State.fullbright and Color3.fromRGB(180, 180, 180) or original.OutdoorAmbient
    Lighting.GlobalShadows = State.lowGraphics and false or original.GlobalShadows
    pcall(function()
        settings().Rendering.QualityLevel = State.lowGraphics and Enum.QualityLevel.Level01 or State.originalQualityLevel
    end)
    for effect, wasEnabled in pairs(State.postEffectSnapshot) do
        if effect.Parent then
            effect.Enabled = State.lowGraphics and false or wasEnabled
        end
    end
end

local function restoreVisualState()
    local original = State.lightingSnapshot
    if original then
        for property, value in pairs(original) do Lighting[property] = value end
    end
    for effect, wasEnabled in pairs(State.postEffectSnapshot) do
        if effect.Parent then effect.Enabled = wasEnabled end
    end
    if State.originalQualityLevel then
        pcall(function() settings().Rendering.QualityLevel = State.originalQualityLevel end)
    end
    State.lightingSnapshot = nil
    State.postEffectSnapshot = {}
    State.originalQualityLevel = nil
end

local function restoreMovement()
    for humanoid, original in pairs(State.originalMovement) do
        if humanoid.Parent then
            humanoid.WalkSpeed = original.walkSpeed
            humanoid.UseJumpPower = original.useJumpPower
            humanoid.JumpPower = original.jumpPower
            humanoid.JumpHeight = original.jumpHeight
        end
    end
    State.originalMovement = {}
    for part, canCollide in pairs(State.originalNoclip) do
        if part.Parent then part.CanCollide = canCollide end
    end
    State.originalNoclip = {}
end

