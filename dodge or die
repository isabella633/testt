local function shouldDodge(ball, root)
    if not ball:IsA("BasePart") then return false, "ignored" end
    local offset = root.Position - ball.Position
    local distance = offset.Magnitude
    local velocity = ball.AssemblyLinearVelocity
    local targeted = isTargeting(ball, root)

    State.lastDistance = distance
    State.lastSpeed = velocity.Magnitude
    State.lastTargeted = targeted

    if distance <= State.distance then
        return true, targeted and "near-targeted" or "near-ball"
    end
    return false, "tracking"
end

local function dodge(reason, ball, root)
    if os.clock() - State.lastDodge < State.cooldown then return end
    if not doDash then doDash = findDash() end
    State.lastDodge = os.clock()
    if State.threat ~= ball then
        State.threat = ball
        local side = (ball.Position - root.Position):Dot(root.CFrame.RightVector)
        State.direction = side < 0 and "Right" or "Left"
    end
    local direction = State.direction
    local sign = direction == "Left" and -1 or 1
    State.evadeVector = root.CFrame.RightVector * sign
    State.evadeUntil = os.clock() + 0.65

    local push = State.evadeVector * State.evadePower
    root.AssemblyLinearVelocity = Vector3.new(push.X, root.AssemblyLinearVelocity.Y, push.Z)
    State.forcedMoves += 1
    State.dodges += 1
    State.lastReason = reason .. ":" .. direction .. ":forced"

    if doDash then
        local ok = pcall(doDash, direction)
        if not ok then
            State.dashErrors += 1
            doDash = nil
            State.dashFound = false
        end
    end
end

