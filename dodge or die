local function calculateSafeCFrame(map, root)
    local minimum = Vector3.new(math.huge, math.huge, math.huge)
    local maximum = Vector3.new(-math.huge, -math.huge, -math.huge)
    local count = 0
    for _, part in ipairs(map:GetDescendants()) do
        if part:IsA("BasePart") then
            count += 1
            local half = part.Size * 0.5
            minimum = Vector3.new(
                math.min(minimum.X, part.Position.X - half.X),
                math.min(minimum.Y, part.Position.Y - half.Y),
                math.min(minimum.Z, part.Position.Z - half.Z)
            )
            maximum = Vector3.new(
                math.max(maximum.X, part.Position.X + half.X),
                math.max(maximum.Y, part.Position.Y + half.Y),
                math.max(maximum.Z, part.Position.Z + half.Z)
            )
        end
    end
    if count == 0 then
        State.safeCenter = root.Position + Vector3.new(0, 10000, 0)
        return CFrame.new(State.safeCenter + Vector3.new(45000, 0, 45000))
    end
    local center = (minimum + maximum) * 0.5
    State.safeCenter = Vector3.new(center.X, maximum.Y + 10000, center.Z)
    State.safePhase = 1
    State.lastSafeShift = os.clock()
    return CFrame.new(State.safeCenter + Vector3.new(45000, 0, 45000))
end

local function ensureAutoWinDecoy()
    if State.decoyAttachment and State.decoyAttachment.Parent then
        return State.decoyAttachment
    end
    local decoy = Instance.new("Part")
    decoy.Name = "CM_AutoWinDecoy"
    decoy.Size = Vector3.one
    decoy.Transparency = 1
    decoy.Anchored = true
    decoy.CanCollide = false
    decoy.CanTouch = false
    decoy.CanQuery = false
    decoy.CFrame = CFrame.new(State.safePosition + Vector3.new(10000, 5000, 10000))
    decoy.Parent = workspace
    local attachment = Instance.new("Attachment")
    attachment.Name = "RootAttachment"
    attachment.Parent = decoy
    State.decoyPart = decoy
    State.decoyAttachment = attachment
    return attachment
end

local function disableBallTarget(ball)
    if not ball:IsA("BasePart") then return end
    local align = ball:FindFirstChild("AlignPosition")
    if not State.ballOriginals[ball] then
        State.ballOriginals[ball] = {
            CanCollide = ball.CanCollide,
            CanTouch = ball.CanTouch,
            CanQuery = ball.CanQuery,
            Attachment1 = align and align.Attachment1 or nil,
            AlignEnabled = align and align.Enabled or nil,
        }
    end
    ball.CanCollide = false
    ball.CanTouch = false
    ball.CanQuery = false
    if align then
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local rootAttachment = root and root:FindFirstChild("RootAttachment")
        if rootAttachment and align.Attachment1 == rootAttachment then
            State.decoyRedirects += 1
        end
        align.Attachment1 = ensureAutoWinDecoy()
        align.Enabled = false
    end
end

