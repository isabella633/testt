-- Dynamic Upgrades Scanner (Auto-detects ANY newly added upgrade stat in game updates)
local function getUpgradeCandidate()
    local upgrades = LocalPlayer:FindFirstChild("Upgrades")
    local points = LocalPlayer:FindFirstChild("Skill Points")
    if not upgrades or not points then return nil end

    local candidates = {}
    local cheapestCost = math.huge
    
    -- Dynamically iterate over ALL children in Upgrades folder
    for _, valueObject in ipairs(upgrades:GetChildren()) do
        local name = valueObject.Name
        local value = tonumber(valueObject.Value) or 0
        local okLvl, level = pcall(function() return UpgradesShared.FindLevel(value) end)
        level = okLvl and level or 0
        local okCost, cost = pcall(function() return UpgradesShared.CalculateCost(name, value, level) end)
        cost = okCost and cost or math.huge
        
        local maxLvl = UpgradesShared.upgradeCosts and UpgradesShared.upgradeCosts[name] and UpgradesShared.upgradeCosts[name].MaxLevel or 100
        if level < maxLvl then
            cheapestCost = math.min(cheapestCost, cost)
            if cost <= points.Value then
                candidates[#candidates + 1] = {name = name, value = value, level = level, cost = cost}
            end
        end
    end
    if #candidates == 0 then return nil, cheapestCost end

    if State.upgradePriority ~= "Balanced" then
        for _, candidate in ipairs(candidates) do
            if candidate.name == State.upgradePriority then return candidate, cheapestCost end
        end
    end

    table.sort(candidates, function(a, b)
        if a.level == b.level then
            if a.value == b.value then return a.name < b.name end
            return a.value < b.value
        end
        return a.level < b.level
    end)
    return candidates[1], cheapestCost
end

