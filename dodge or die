local function jointConnectsOutsideCharacter(joint, character)
    local part0 = joint:IsA("JointInstance") and joint.Part0 or nil
    local part1 = joint:IsA("JointInstance") and joint.Part1 or nil
    if part0 or part1 then
        local part0Inside = part0 and part0:IsDescendantOf(character) or false
        local part1Inside = part1 and part1:IsDescendantOf(character) or false
        return part0Inside ~= part1Inside
    end
    if joint:IsA("Constraint") then
        local attachment0 = joint.Attachment0
        local attachment1 = joint.Attachment1
        if attachment0 or attachment1 then
            local attachment0Inside = attachment0 and attachment0:IsDescendantOf(character) or false
            local attachment1Inside = attachment1 and attachment1:IsDescendantOf(character) or false
            return attachment0Inside ~= attachment1Inside
        end
    end
    return false
end

