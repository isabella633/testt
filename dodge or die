local function queueHubReload()
    if not State.autoReloadHub then return false end
    local queue = queue_on_teleport or (syn and syn.queue_on_teleport)
    if typeof(queue) ~= "function" then return false end
    local queuedCode = [[
task.wait(3)
pcall(function()
    loadstring(__CMHUB_GET_TEXT_V1("https://pastefy.app/yVwruY6w/raw"))()
end)
]]
    return pcall(queue, queuedCode)
end

local function rejoinServer()
    if State.teleportBusy then return end
    State.teleportBusy = true
    queueHubReload()
    Library:Notify({ Type = "Info", Title = "Rejoining", Content = "Reconnecting to Dodge or Die...", Duration = 4 })
    local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
    if not ok then
        State.teleportBusy = false
        Library:Notify({ Type = "Error", Title = "Rejoin Failed", Content = "Teleport request rejected.", Duration = 4 })
    end
end

local function hopServer()
    if State.teleportBusy then return end
    State.teleportBusy = true
    State.lastServerHopStatus = "Searching for a populated server"
    task.spawn(function()
        local cursor = nil
        local chosen = nil
        local chosenPopulation = -1
        for _ = 1, 3 do
            local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100", game.PlaceId)
            if cursor then url ..= "&cursor=" .. HttpService:UrlEncode(cursor) end
            local ok, page = pcall(function() return HttpService:JSONDecode(__CMHUB_GET_TEXT_V1(url)) end)
            if not ok or typeof(page) ~= "table" then break end
            for _, server in ipairs(page.data or {}) do
                if server.id ~= game.JobId
                    and server.playing < server.maxPlayers
                    and server.playing + 1 >= State.minimumServerPlayers
                    and server.playing > chosenPopulation then
                    chosen = server.id
                    chosenPopulation = server.playing
                end
            end
            if chosen or not page.nextPageCursor then break end
            cursor = page.nextPageCursor
        end
        if chosen then
            State.lastServerHopStatus = string.format("Joining server with %d players", chosenPopulation)
            queueHubReload()
            Library:Notify({ Type = "Success", Title = "Server Hop", Content = State.lastServerHopStatus, Duration = 4 })
            local ok = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen, LocalPlayer) end)
            if ok then return end
        end
        State.teleportBusy = false
        State.lowPopulationSince = 0
        State.serverHopGraceUntil = os.clock() + 20
        State.lastServerHopStatus = "No suitable populated server found"
        Library:Notify({ Type = "Warning", Title = "Server Hop", Content = "No open server found. Try again shortly.", Duration = 4 })
    end)
end

State.serverHopConnection = RunService.Heartbeat:Connect(function()
    if not State.autoServerHop or State.teleportBusy then return end
    local now = os.clock()
    if now < State.serverHopGraceUntil or now - State.lastPopulationCheck < 5 then return end
    State.lastPopulationCheck = now
    local playerCount = #Players:GetPlayers()
    if playerCount >= State.minimumServerPlayers then
        State.lowPopulationSince = 0
        State.lastServerHopStatus = string.format("Population healthy: %d/%d players", playerCount, State.minimumServerPlayers)
        return
    end
    if State.lowPopulationSince == 0 then
        State.lowPopulationSince = now
        State.lastServerHopStatus = string.format("Low population: %d/%d; confirming...", playerCount, State.minimumServerPlayers)
    elseif now - State.lowPopulationSince >= 10 then
        State.lastServerHopStatus = string.format("Only %d players; finding a fuller server", playerCount)
        hopServer()
    end
end)

