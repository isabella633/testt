            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            State.antiAbilityLastBlocked = "Fling / knockback"
        end
    end

    local playing = CollectionService:HasTag(character, "Playing")
    if State.antiAbilityCharacter ~= character then
        State.antiAbilityCharacter = character
        State.antiAbilityLastCFrame = root.CFrame
        State.antiAbilityLastPlaying = playing
    elseif playing and State.antiAbilityLastPlaying and not State.autoWinActive and State.antiAbilityLastCFrame then
